diff --git a/libfprint/drivers/elanpress.c b/libfprint/drivers/elanpress.c
index 672f17e..59e9e96 100644
--- a/libfprint/drivers/elanpress.c
+++ b/libfprint/drivers/elanpress.c
@@ -270,6 +270,15 @@ elanpress_frame_cb (FpiUsbTransfer *transfer, FpDevice *dev,
 
   if (error)
     {
+      if (g_error_matches (error, G_USB_DEVICE_ERROR, G_USB_DEVICE_ERROR_TIMED_OUT) &&
+          fpi_ssm_get_cur_state (transfer->ssm) == CAPTURE_POLL_READ &&
+          self->num_frames == 0)
+        {
+          fp_dbg ("transient idle poll timeout, resuming poll");
+          fpi_ssm_jump_to_state_delayed (transfer->ssm, CAPTURE_POLL_REQUEST,
+                                         ELANPRESS_IDLE_POLL_INTERVAL_MS);
+          return;
+        }
       fpi_ssm_mark_failed (transfer->ssm, error);
       return;
     }
